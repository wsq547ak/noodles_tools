{
  "name": "tiny-toolbox",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm --workspace @tiny/web run dev",
    "dev:backend": "python3 -m services.picZip.server",
    "dev:picZip": "python3 -m services.picZip.server",
    "dev": "npm run dev:web",
    "build:web": "npm --workspace @tiny/web run build",
    "start:web": "PORT=4001 node apps/web/.next/standalone/apps/web/server.js",
    "prod:web": "npm run build:web && npm run start:web",
    "lint:web": "npm --workspace @tiny/web run lint",
    "test:picZip": "python3 -m unittest discover -s services/picZip/tests -v",
    "test:randomStu": "python3 -m unittest discover -s services/randomStu/tests -v"
  }
}
